{
  "version": 1,
  "description": "Everything the voice assistant can do. The planner prompt, the JSON schema, the validator and the clarifying questions are all generated from this file. Add an action here and implement its handler in executor.ts; nothing else needs editing.",
  "selectorFilters": {
    "missing_attendance": "workers with no attendance record on the date (default today)",
    "not_marked_today": "same as missing_attendance for today",
    "failed_payment": "workers with a failed payment this period",
    "pending_payout": "workers with a payout waiting for approval",
    "needs_review": "workers whose payout is flagged Needs Review"
  },
  "queryKinds": {
    "payout_summary": "overall payout and payment progress for the period",
    "failed_payments": "which payments failed and why",
    "pending_payouts": "payouts waiting for approval and payments still processing",
    "completed_payments": "payments that completed",
    "processing_payments": "payments still being processed by PayPal",
    "needs_review": "workers flagged Needs Review and the reasons",
    "missing_attendance": "workers with no attendance record on a date (default today)",
    "attendance_summary": "how many present, half day, absent and on leave on a date",
    "worker_pay": "one worker's calculated pay for the period (needs workers)",
    "totals": "total payout amount calculated for the period and the amount waiting for approval",
    "top_earners": "the highest paid workers this period (optional n, default 3)",
    "worker_list": "list active workers, optionally for a city or selector",
    "rules_summary": "the current incentive rules and tiers"
  },
  "pages": [
    "dashboard",
    "workers",
    "attendance",
    "incentives",
    "payouts",
    "transactions"
  ],
  "actions": {
    "mark_attendance": {
      "description": "Record attendance for one or more workers.",
      "risk": "write",
      "changesPayData": true,
      "slots": {
        "workers": {
          "type": "workerSelector",
          "required": true,
          "ask": "Which workers should I mark?"
        },
        "status": {
          "type": "enum",
          "values": [
            "present",
            "half",
            "absent",
            "leave"
          ],
          "required": true,
          "ask": "Should I mark them present, absent, half day or on leave?"
        },
        "date": {
          "type": "date",
          "required": false
        }
      },
      "summary": "Mark {workers} {status} {date}",
      "examples": [
        {
          "say": "mark Ravi and Anita absent today",
          "steps": [
            {
              "action": "mark_attendance",
              "args": {
                "workers": {
                  "scope": "names",
                  "names": [
                    "Ravi Kumar",
                    "Anita Sharma"
                  ]
                },
                "status": "absent"
              }
            }
          ]
        },
        {
          "say": "mark everyone present except Priya",
          "steps": [
            {
              "action": "mark_attendance",
              "args": {
                "workers": {
                  "scope": "all",
                  "except": [
                    "Priya Nair"
                  ]
                },
                "status": "present"
              }
            }
          ]
        },
        {
          "say": "mark all riders absent",
          "steps": [
            {
              "action": "mark_attendance",
              "args": {
                "workers": {
                  "scope": "all"
                },
                "status": "absent"
              }
            }
          ]
        }
      ]
    },
    "record_overtime": {
      "description": "Record overtime hours for workers.",
      "risk": "write",
      "changesPayData": true,
      "slots": {
        "workers": {
          "type": "workerSelector",
          "required": true,
          "ask": "Whose overtime should I record?"
        },
        "hours": {
          "type": "number",
          "required": true,
          "min": 0,
          "max": 24,
          "ask": "How many overtime hours?"
        },
        "date": {
          "type": "date",
          "required": false
        }
      },
      "summary": "Record {hours} overtime hours for {workers} {date}",
      "examples": [
        {
          "say": "Anita worked two hours overtime yesterday",
          "steps": [
            {
              "action": "record_overtime",
              "args": {
                "workers": {
                  "scope": "names",
                  "names": [
                    "Anita Sharma"
                  ]
                },
                "hours": 2,
                "date": "<yesterday>"
              }
            }
          ]
        }
      ]
    },
    "record_units": {
      "description": "Record how many deliveries (units) workers completed.",
      "risk": "write",
      "changesPayData": true,
      "slots": {
        "workers": {
          "type": "workerSelector",
          "required": true,
          "ask": "Whose deliveries should I record?"
        },
        "units": {
          "type": "number",
          "required": true,
          "min": 0,
          "max": 100000,
          "ask": "How many deliveries?"
        },
        "date": {
          "type": "date",
          "required": false
        }
      },
      "summary": "Record {units} deliveries for {workers} {date}",
      "examples": [
        {
          "say": "Mohammed Ali did twenty five deliveries today",
          "steps": [
            {
              "action": "record_units",
              "args": {
                "workers": {
                  "scope": "names",
                  "names": [
                    "Mohammed Ali"
                  ]
                },
                "units": 25
              }
            }
          ]
        }
      ]
    },
    "prepare_payouts": {
      "description": "Calculate incentives with the rules engine and queue payouts for approval (workers with missing or conflicting records are flagged Needs Review automatically). The selector limits who is included. Never give an amount.",
      "risk": "write",
      "slots": {
        "workers": {
          "type": "workerSelector",
          "required": false,
          "ask": "Which workers should I prepare payouts for?"
        },
        "date": {
          "type": "date",
          "required": false
        }
      },
      "summary": "Prepare payouts for {workers}",
      "examples": [
        {
          "say": "calculate incentives for Bengaluru riders who completed at least twenty deliveries today",
          "steps": [
            {
              "action": "prepare_payouts",
              "args": {
                "workers": {
                  "scope": "city",
                  "city": "Bengaluru",
                  "minUnits": 20
                }
              }
            }
          ]
        },
        {
          "say": "prepare payouts for everyone",
          "steps": [
            {
              "action": "prepare_payouts",
              "args": {
                "workers": {
                  "scope": "all"
                }
              }
            }
          ]
        }
      ]
    },
    "approve_payouts": {
      "description": "Approve pending payouts and send them to PayPal. Omit workers for every pending payout. Moves money.",
      "risk": "money",
      "slots": {
        "workers": {
          "type": "workerSelector",
          "required": false,
          "ask": "Whose payouts should I approve?"
        }
      },
      "summary": "Approve and send payouts for {workers}",
      "examples": [
        {
          "say": "approve Ravi's payout",
          "steps": [
            {
              "action": "approve_payouts",
              "args": {
                "workers": {
                  "scope": "names",
                  "names": [
                    "Ravi Kumar"
                  ]
                }
              }
            }
          ]
        },
        {
          "say": "approve everything that is pending",
          "steps": [
            {
              "action": "approve_payouts",
              "args": {
                "workers": {
                  "scope": "all"
                }
              }
            }
          ]
        }
      ]
    },
    "reject_payouts": {
      "description": "Reject pending payouts (nothing is sent). Omit workers for every pending payout.",
      "risk": "write",
      "slots": {
        "workers": {
          "type": "workerSelector",
          "required": false,
          "ask": "Whose payouts should I reject?"
        }
      },
      "summary": "Reject payouts for {workers}",
      "examples": [
        {
          "say": "reject payouts for Priya and Karthik",
          "steps": [
            {
              "action": "reject_payouts",
              "args": {
                "workers": {
                  "scope": "names",
                  "names": [
                    "Priya Nair",
                    "Karthik Murthy"
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "retry_failed": {
      "description": "Retry failed payments. Omit workers for all. Moves money.",
      "risk": "money",
      "slots": {
        "workers": {
          "type": "workerSelector",
          "required": false,
          "ask": "Whose failed payments should I retry?"
        }
      },
      "summary": "Retry failed payments for {workers}",
      "examples": [
        {
          "say": "retry the failed payments",
          "steps": [
            {
              "action": "retry_failed",
              "args": {
                "workers": {
                  "scope": "all"
                }
              }
            }
          ]
        }
      ]
    },
    "sync_status": {
      "description": "Refresh payment statuses from PayPal.",
      "risk": "read",
      "slots": {},
      "summary": "Refresh payment statuses from PayPal",
      "examples": [
        {
          "say": "refresh the payment status",
          "steps": [
            {
              "action": "sync_status",
              "args": {}
            }
          ]
        }
      ]
    },
    "update_worker": {
      "description": "Change one worker's field; value is text (a number for dailyWage, active or inactive for status).",
      "risk": "write",
      "changesPayData": true,
      "slots": {
        "workers": {
          "type": "workerSelector",
          "required": true,
          "ask": "Which worker should I update?"
        },
        "field": {
          "type": "enum",
          "values": [
            "dailyWage",
            "payoutEmail",
            "city",
            "role",
            "phone",
            "status"
          ],
          "required": true,
          "ask": "What should I change: wage, PayPal email, city, role, phone or status?"
        },
        "value": {
          "type": "string",
          "required": true,
          "ask": "What is the new value?"
        }
      },
      "summary": "Set {field} to {value} for {workers}",
      "examples": [
        {
          "say": "set Divya's daily wage to seven hundred",
          "steps": [
            {
              "action": "update_worker",
              "args": {
                "workers": {
                  "scope": "names",
                  "names": [
                    "Divya Hegde"
                  ]
                },
                "field": "dailyWage",
                "value": "700"
              }
            }
          ]
        },
        {
          "say": "deactivate Tanvir",
          "steps": [
            {
              "action": "update_worker",
              "args": {
                "workers": {
                  "scope": "names",
                  "names": [
                    "Tanvir Alam"
                  ]
                },
                "field": "status",
                "value": "inactive"
              }
            }
          ]
        }
      ]
    },
    "add_worker": {
      "description": "Add a new worker.",
      "risk": "write",
      "slots": {
        "name": {
          "type": "string",
          "required": true,
          "ask": "What is the new worker's full name?"
        },
        "role": {
          "type": "string",
          "required": false
        },
        "city": {
          "type": "string",
          "required": false
        },
        "dailyWage": {
          "type": "number",
          "required": true,
          "min": 1,
          "max": 100000,
          "ask": "What is their daily wage in rupees?"
        },
        "payoutEmail": {
          "type": "email",
          "required": false
        }
      },
      "summary": "Add worker {name} with a daily wage of ₹{dailyWage}",
      "examples": [
        {
          "say": "add a new rider Suman Das in Bengaluru with wage six hundred",
          "steps": [
            {
              "action": "add_worker",
              "args": {
                "name": "Suman Das",
                "city": "Bengaluru",
                "dailyWage": 600
              }
            }
          ]
        }
      ]
    },
    "set_rule": {
      "description": "Change one incentive rule: overtimeMultiplier, workingHoursPerDay, dailyUnitTarget, ratePerExtraUnit (rupees per delivery above the daily target), attendanceThreshold (0 to 1), attendanceBonus (rupees).",
      "risk": "write",
      "changesPayData": true,
      "slots": {
        "ruleKey": {
          "type": "enum",
          "values": [
            "overtimeMultiplier",
            "workingHoursPerDay",
            "dailyUnitTarget",
            "ratePerExtraUnit",
            "attendanceThreshold",
            "attendanceBonus"
          ],
          "required": true,
          "ask": "Which rule should I change?"
        },
        "amount": {
          "type": "number",
          "required": true,
          "min": 0,
          "ask": "What should the new value be?"
        }
      },
      "summary": "Set rule {ruleKey} to {amount}",
      "examples": [
        {
          "say": "set the attendance bonus to three hundred",
          "steps": [
            {
              "action": "set_rule",
              "args": {
                "ruleKey": "attendanceBonus",
                "amount": 300
              }
            }
          ]
        }
      ]
    },
    "set_tier": {
      "description": "Add or change a daily delivery tier: at least minUnits deliveries in a day pays amount rupees.",
      "risk": "write",
      "changesPayData": true,
      "slots": {
        "minUnits": {
          "type": "number",
          "required": true,
          "min": 1,
          "ask": "At how many deliveries a day does the tier start?"
        },
        "amount": {
          "type": "number",
          "required": true,
          "min": 0,
          "ask": "What bonus in rupees?"
        }
      },
      "summary": "Set the {minUnits}-delivery tier bonus to ₹{amount}",
      "examples": [
        {
          "say": "make the twenty delivery bonus one hundred twenty rupees",
          "steps": [
            {
              "action": "set_tier",
              "args": {
                "minUnits": 20,
                "amount": 120
              }
            }
          ]
        }
      ]
    },
    "remove_tier": {
      "description": "Remove a daily delivery tier.",
      "risk": "write",
      "changesPayData": true,
      "slots": {
        "minUnits": {
          "type": "number",
          "required": true,
          "min": 1,
          "ask": "Which tier should I remove (its delivery count)?"
        }
      },
      "summary": "Remove the {minUnits}-delivery tier",
      "examples": [
        {
          "say": "remove the thirty delivery tier",
          "steps": [
            {
              "action": "remove_tier",
              "args": {
                "minUnits": 30
              }
            }
          ]
        }
      ]
    },
    "query": {
      "description": "Answer a question from stored records (read-only). Pick the kind; the server computes the answer.",
      "risk": "read",
      "slots": {
        "query": {
          "type": "enum",
          "valuesFrom": "queryKinds",
          "required": true,
          "ask": "What would you like to know?"
        },
        "workers": {
          "type": "workerSelector",
          "required": false
        },
        "date": {
          "type": "date",
          "required": false
        },
        "n": {
          "type": "number",
          "required": false,
          "min": 1,
          "max": 25
        }
      },
      "summary": "Answer: {query}",
      "examples": [
        {
          "say": "how many payments failed",
          "steps": [
            {
              "action": "query",
              "args": {
                "query": "failed_payments"
              }
            }
          ]
        },
        {
          "say": "who has not been marked today",
          "steps": [
            {
              "action": "query",
              "args": {
                "query": "missing_attendance"
              }
            }
          ]
        },
        {
          "say": "what is Anita's pay this period",
          "steps": [
            {
              "action": "query",
              "args": {
                "query": "worker_pay",
                "workers": {
                  "scope": "names",
                  "names": [
                    "Anita Sharma"
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "navigate": {
      "description": "Open a screen.",
      "risk": "read",
      "slots": {
        "page": {
          "type": "enum",
          "valuesFrom": "pages",
          "required": true,
          "ask": "Which screen should I open?"
        }
      },
      "summary": "Open {page}",
      "examples": [
        {
          "say": "show me the transactions",
          "steps": [
            {
              "action": "navigate",
              "args": {
                "page": "transactions"
              }
            }
          ]
        }
      ]
    }
  },
