# BolPay — copy this file to .env and fill in the values. Never commit .env.

# ---------------------------------------------------------------------------
# PayPal (REQUIRED for checkout + payouts)
# Get these at https://developer.paypal.com/dashboard/applications/sandbox
#   -> Apps & Credentials -> Sandbox tab -> Create App (or open "Default Application")
#   -> copy "Client ID" and "Secret".
# Payouts must be enabled for the app: open the app -> Features -> tick "Payouts".
# Payout recipients (worker emails) must be sandbox personal accounts:
#   Dashboard -> Testing Tools -> Sandbox Accounts.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" (default, safe) or "production" (real money; also needs ALLOW_LIVE_PAYOUTS=true)
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox

# Webhook ID, used to verify PayPal webhook signatures (OPTIONAL until you test webhooks).
# Same app page -> scroll to "Webhooks" -> Add Webhook. The URL must be public HTTPS, so run
# a tunnel (e.g. `ngrok http 3000`) and use https://<tunnel>/api/webhooks/paypal.
# Subscribe to the PAYMENT.PAYOUTSBATCH.* and PAYMENT.PAYOUTS-ITEM.* events, then copy the Webhook ID.
# Without it, use the "sync" action in the Payouts screen to pull statuses instead.
PAYPAL_WEBHOOK_ID=

# Currency sent to PayPal Payouts (default USD). Sandbox supports USD, EUR, GBP, etc., not INR.
PAYOUT_CURRENCY=USD
# Amounts are stored/shown in INR. PayPal settles in PAYOUT_CURRENCY at this rate (INR per 1 USD, default 85).
INR_PER_USD=85
# Safety switch: payouts are refused in production unless this is "true". Leave unset for the hackathon.
ALLOW_LIVE_PAYOUTS=

# ---------------------------------------------------------------------------
# ElevenLabs (REQUIRED for voice input + spoken replies)
# https://elevenlabs.io/app/settings/api-keys -> Create API key
# (needs Speech-to-Text and Text-to-Speech access).
# ---------------------------------------------------------------------------
ELEVEN_LABS_API_KEY=
# OPTIONAL. Voice ID from https://elevenlabs.io/app/voice-library (default: JBFqnCBsd6RMkjVDRZzb)
ELEVEN_LABS_VOICE_ID=
# OPTIONAL. Default: eleven_multilingual_v2
ELEVEN_LABS_TTS_MODEL=

# ---------------------------------------------------------------------------
# Groq (REQUIRED for the voice intent / translation LLM)
# https://console.groq.com/keys -> Create API Key (free tier is enough for testing).
# ---------------------------------------------------------------------------
GROQ_API_KEY=
# OPTIONAL. Default: openai/gpt-oss-120b
GROQ_MODEL=
