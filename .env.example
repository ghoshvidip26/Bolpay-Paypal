# BolPay — copy this file to .env and fill in the values. Never commit .env.

# ---------------------------------------------------------------------------
# PayPal (REQUIRED for checkout + payouts)
# Get these at https://developer.paypal.com/dashboard/applications/sandbox
#   -> Apps & Credentials -> Sandbox tab -> Create App (or open "Default Application")
#   -> copy "Client ID" and "Secret".
# Payouts must be enabled for the app: open the app -> Features -> tick "Payouts".
# Payout recipients (worker emails) must be sandbox personal accounts:
#   Dashboard -> Testing Tools -> Sandbox Accounts.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" (default, safe) or "production" (real money; also needs ALLOW_LIVE_PAYOUTS=true)
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox

# Webhook ID, used to verify PayPal webhook signatures (OPTIONAL until you test webhooks).
# Same app page -> scroll to "Webhooks" -> Add Webhook. The URL must be public HTTPS, so run
# a tunnel (e.g. `ngrok http 3000`) and use https://<tunnel>/api/webhooks/paypal.
# Subscribe to the PAYMENT.PAYOUTSBATCH.* and PAYMENT.PAYOUTS-ITEM.* events, then copy the Webhook ID.
# Without it, use the "sync" action in the Payouts screen to pull statuses instead.
PAYPAL_WEBHOOK_ID=

# Currency sent to PayPal Payouts (default USD). Sandbox supports USD, EUR, GBP, etc., not INR.
PAYOUT_CURRENCY=USD
# Amounts are stored/shown in INR. PayPal settles in PAYOUT_CURRENCY at this rate (INR per 1 USD, default 85).
INR_PER_USD=85
# Safety switch: payouts are refused in production unless this is "true". Leave unset for the hackathon.
ALLOW_LIVE_PAYOUTS=

# ---------------------------------------------------------------------------
# ElevenLabs (REQUIRED for voice input + spoken replies)
# https://elevenlabs.io/app/settings/api-keys -> Create API key
# (needs Speech-to-Text and Text-to-Speech access).
# ---------------------------------------------------------------------------
ELEVEN_LABS_API_KEY=
# OPTIONAL. Voice ID from https://elevenlabs.io/app/voice-library (default: JBFqnCBsd6RMkjVDRZzb)
ELEVEN_LABS_VOICE_ID=
# OPTIONAL. Default: eleven_multilingual_v2
ELEVEN_LABS_TTS_MODEL=

# ---------------------------------------------------------------------------
# Groq (REQUIRED for the voice intent / translation LLM)
# https://console.groq.com/keys -> Create API Key (free tier is enough for testing).
# ---------------------------------------------------------------------------
GROQ_API_KEY=
# OPTIONAL. Default: openai/gpt-oss-120b
GROQ_MODEL=
# OPTIONAL. Comma-separated planner models for voice commands, tried in order when one is rate-limited.
# Default: GROQ_MODEL, then openai/gpt-oss-20b. (Groq's free tier is 8,000 tokens per minute per model.)
VOICE_PLANNER_MODELS=

# OPTIONAL. Folder for the JSON data files. Default .data in the project. On Vercel (read-only project folder) use /tmp/bolpay-data.
# /tmp is wiped on cold starts, so a hosted demo re-seeds itself; keep the real data in a database before relying on it.
DATA_DIR=

# Supabase (login and roles). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Zoho People (OPTIONAL: import employees and attendance from your Zoho HRMS)
# How to get the keys (about 5 minutes, you must be the Zoho account owner):
#  1. Open https://api-console.zoho.in  (use .com / .eu etc. if your portal is not on the India data center)
#  2. Add Client -> "Server-based Applications". Any name, homepage http://localhost:3000
#  3. Authorized Redirect URI:  http://localhost:3000/api/zoho/callback   (must match ZOHO_REDIRECT_URI exactly)
#  4. Create, then copy the Client ID and Client Secret below. Restart `npm run dev`.
#  5. In BolPay: sign in as the owner -> Integrations -> Connect Zoho -> allow -> Sync now.
# Alternative without the redirect flow: in the API console choose "Self Client", generate a code with the
# scopes below (time duration 10 minutes), exchange it once for a refresh token, and put it in ZOHO_REFRESH_TOKEN.
# ---------------------------------------------------------------------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# OPTIONAL. Defaults are for the India data center (people.zoho.in).
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_PEOPLE_URL=https://people.zoho.in
ZOHO_REDIRECT_URI=http://localhost:3000/api/zoho/callback
# OPTIONAL. Read-only access to the Employee form and attendance. If Zoho says invalid_scope for attendance,
# try ZOHOPEOPLE.forms.READ,ZOHOPEOPLE.attendance.ALL
ZOHO_SCOPES=ZOHOPEOPLE.forms.READ,ZOHOPEOPLE.attendance.READ
ZOHO_REFRESH_TOKEN=
# Zoho People has no salary data, so new employees get this daily wage (in rupees) until you edit it in BolPay.
ZOHO_DEFAULT_DAILY_WAGE=1200
# OPTIONAL. Names of custom fields on the Zoho Employee form that hold a daily wage and a PayPal email.
ZOHO_WAGE_FIELD=
ZOHO_PAYOUT_EMAIL_FIELD=
# City to use when an employee's address has none.
ZOHO_DEFAULT_CITY=Unknown
